# Copy to .env and fill in. .env is git-ignored.
# Values here are read by `config/index.ts`.

# AWS account that owns the stacks (12 digits). Also used for CDK bootstrap.
CDK_ACCOUNT=123456789012

# Region for the application stacks. CloudFront certificates always use us-east-1.
CDK_REGION=eu-west-1

# Optional: region bootstrapped for CloudFront certificates. Only change it if you
# also change CLOUDFRONT_CERTIFICATE_REGION in config/types.ts (CloudFront requires us-east-1).
# CERTIFICATE_REGION=us-east-1

# Apex domain. Must be a zone you control (or delegate to the created zone).
ROOT_DOMAIN=example.com

# Optional: reuse an existing Route 53 hosted zone instead of creating one.
# HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ

# Optional: override the stage (development | staging | production).
# CDK_STAGE=development

# Optional: use an existing JSON secret instead of the generated one.
# APP_SECRET_ARN=arn:aws:secretsmanager:eu-west-1:123456789012:secret:my-app-AbCdEf

# Optional: image tag used by `npm run deploy:demo` (defaults to the git sha).
# IMAGE_TAG=0.1.0
