{
  "name": "aws-cdk-fullstack-infra",
  "version": "1.0.0",
  "description": "Opinionated AWS CDK v2 template for full-stack apps: Fargate API, PostgreSQL, S3/CloudFront frontend, ClickHouse and a private VPC with fck-nat.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "watch": "tsc -w --noEmit",
    "test": "jest",
    "synth": "cdk synth",
    "synth:offline": "ts-node --prefer-ts-exts scripts/synth-offline.ts",
    "lint:cfn": "bash scripts/cfn-lint.sh",
    "validate": "npm run build && npm test && npm run synth:offline",
    "validate:fakecloud": "bash scripts/fakecloud.sh",
    "diff": "cdk diff",
    "deploy": "cdk deploy --all --require-approval broadening --outputs-file cdk-outputs.development.json",
    "deploy:demo": "bash scripts/deploy-demo.sh",
    "deploy:staging": "cdk deploy --all -c stage=staging --require-approval broadening --outputs-file cdk-outputs.staging.json",
    "deploy:production": "cdk deploy --all -c stage=production --require-approval broadening --outputs-file cdk-outputs.production.json",
    "destroy": "cdk destroy --all",
    "destroy:production": "cdk destroy --all -c stage=production",
    "bootstrap": "bash scripts/bootstrap.sh",
    "push-image": "bash scripts/push-image.sh",
    "deploy-site": "bash scripts/deploy-site.sh"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.9",
    "aws-cdk": "2.1005.0",
    "aws-cdk-local": "^3.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.181.1",
    "cdk-fck-nat": "^1.5.21",
    "constructs": "^10.0.0"
  }
}
